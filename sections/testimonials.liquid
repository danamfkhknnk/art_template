<section class="relative py-24 px-4">
  <div class="absolute inset-0 bg-dark/80 backdrop-blur-sm"></div>
  <div class="relative section-content">
    <div class="text-center mb-16">
      <p class="text-caption tracking-[0.3em] uppercase text-(--color-accent) mb-4 font-medium inline-flex items-center gap-2 reveal">
        <span class="w-8 h-px bg-gradient-to-r from-transparent to-(--color-accent)"></span>
        {{ section.settings.subheading }}
        <span class="w-8 h-px bg-gradient-to-l from-transparent to-(--color-accent)"></span>
      </p>
      <h2 class="text-heading font-display text-(--color-foreground) reveal reveal-delay-1">{{ section.settings.heading }}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for block in section.blocks %}
        <div class="gradient-border-card p-8 relative group reveal" style="transition-delay: {{ forloop.index | times: 0.1 }}s;" {{ block.shopify_attributes }}>
          <svg class="w-10 h-10 text-(--color-accent)/30 mb-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
          <p class="text-body text-((--color-foreground))/80 leading-relaxed mb-6 italic">"{{ block.settings.quote }}"</p>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-(--color-accent)/20 to-(--color-secondary)/20 flex items-center justify-center border border-(--color-accent)/30">
              <span class="text-body font-semibold text-(--color-accent)">{{ block.settings.author | truncate: 2, "" }}</span>
            </div>
            <div>
              <p class="text-body-sm font-medium text-(--color-foreground)">{{ block.settings.author }}</p>
              <div class="flex items-center gap-1 mt-1">
                {% for i in (1..5) %}
                  {% if i <= block.settings.rating %}
                    <svg class="w-4 h-4 text-(--color-accent)" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  {% else %}
                    <svg class="w-4 h-4 text-(--color-muted)/30" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  {% endif %}
                {% endfor %}
              </div>
              {% if block.settings.platform != blank %}
                <p class="text-caption text-(--color-muted) mt-1">via {{ block.settings.platform }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Testimonials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Clients Say"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Amazing work! The artist brought my character to life exactly as I imagined."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "John Doe"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "platform",
          "label": "Platform",
          "default": "Twitter"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "The level of detail and creativity is outstanding. My OC has never looked better!",
            "author": "Sarah Chen",
            "rating": 5,
            "platform": "Twitter"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Fast delivery, great communication, and the art exceeded my expectations.",
            "author": "Mike Johnson",
            "rating": 5,
            "platform": "Discord"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "I've commissioned many artists but this was by far the best experience.",
            "author": "Alex Rivera",
            "rating": 5,
            "platform": "Instagram"
          }
        }
      ]
    }
  ]
}
{% endschema %}
