<section class="relative py-24 px-4">
  <div class="absolute inset-0 bg-dark/80 backdrop-blur-sm"></div>
  <div class="relative section-content">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="reveal">
        <p class="text-caption tracking-[0.3em] uppercase text-(--color-accent) pb-2 font-medium inline-flex items-center gap-2">
          <span class="w-8 h-px bg-gradient-to-r from-transparent to-(--color-accent)"></span>
          {{ section.settings.subheading }}
        </p>
        <h2 class="text-heading font-display text-(--color-foreground) mb-6">{{ section.settings.heading }}</h2>
        <div class="text-body text-((--color-foreground))/70 leading-relaxed pb-4">
          {{ section.settings.content }}
        </div>

        <div class="flex flex-wrap gap-3 mb-8">
          {% assign genres = "Portrait,Character Design,Illustration,Fan Art,Concept Art,Chibi" | split: "," %}
          {% for genre in genres %}
            <span class="px-4 py-2 bg-surface/50 border border-(--color-muted)/10 rounded-full text-caption text-(--color-muted) hover:border-(--color-accent)/30 hover:text-(--color-accent) hover:bg-(--color-accent)/5 transition-all duration-300 cursor-default">
              {{ genre }}
            </span>
          {% endfor %}
        </div>

        <div class="grid grid-cols-3 gap-3 md:gap-6 pt-2">
          {% if section.settings.stat_1_number != blank %}
            <div class="text-center p-4 gradient-border-card">
              <p class="text-subheading font-display gradient-text font-bold">{{ section.settings.stat_1_number }}</p>
              <p class="text-caption text-(--color-muted) mt-1">{{ section.settings.stat_1_label }}</p>
            </div>
          {% endif %}
          {% if section.settings.stat_2_number != blank %}
            <div class="text-center p-4 gradient-border-card">
              <p class="text-subheading font-display gradient-text font-bold">{{ section.settings.stat_2_number }}</p>
              <p class="text-caption text-(--color-muted) mt-1">{{ section.settings.stat_2_label }}</p>
            </div>
          {% endif %}
          {% if section.settings.stat_3_number != blank %}
            <div class="text-center p-4 gradient-border-card">
              <p class="text-subheading font-display gradient-text font-bold">{{ section.settings.stat_3_number }}</p>
              <p class="text-caption text-(--color-muted) mt-1">{{ section.settings.stat_3_label }}</p>
            </div>
          {% endif %}
        </div>

        <div class="mt-8">
          <a href="/pages/gallery" class="btn-secondary inline-flex items-center gap-2">
            <span>View Showcase</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="relative reveal reveal-delay-2">
        <div class="relative rounded-2xl overflow-hidden border border-(--color-muted)/10 hover:border-(--color-accent)/30 transition-all duration-500">
          <img
            src="{{ 'about.webp' | asset_url }}"
            alt="{{ section.settings.heading }}"
            class="w-full h-auto object-cover"
            loading="lazy"
            width="800"
            height="600"
          >
          <div class="absolute inset-0 bg-gradient-to-t from-(--color-dark)/60 via-transparent to-transparent"></div>
        </div>
        <div class="absolute -bottom-4 -right-4 w-32 h-32 bg-(--color-accent)/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-4 -left-4 w-24 h-24 bg-(--color-secondary)/10 rounded-full blur-3xl"></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "About Me"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Artist Behind The Work"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>I've been drawing since I was a kid, spending hours sketching characters and worlds that lived in my imagination. What started as a hobby quickly became my passion.</p><p>Over the years, I've honed my skills in digital illustration, character design, and now — Shopify theme design. I combine my artistic background with modern web design to create templates that don't just look good, they tell a story.</p>"
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Stat 1 Number",
      "default": "8+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Years Drawing"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Stat 2 Number",
      "default": "50+"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Projects Done"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Stat 3 Number",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "Passion Driven"
    }
  ],
  "presets": [
    {
      "name": "About"
    }
  ]
}
{% endschema %}
