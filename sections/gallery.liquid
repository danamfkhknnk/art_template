<section class="relative py-25 px-4">
  <div class="absolute inset-0 bg-dark/80 backdrop-blur-sm"></div>
  <div class="relative section-content">
    <div class="text-center mb-16">
      <p class="text-caption tracking-[0.3em] uppercase text-(--color-accent) mb-4 font-medium inline-flex items-center gap-2 justify-center reveal">
        <span class="w-8 h-px bg-gradient-to-r from-transparent to-(--color-accent)"></span>
        {{ section.settings.subheading }}
        <span class="w-8 h-px bg-gradient-to-l from-transparent to-(--color-accent)"></span>
      </p>
      <h2 class="text-heading font-display text-(--color-foreground) reveal reveal-delay-1">{{ section.settings.heading }}</h2>
    </div>

    <!-- Filter tabs -->
    <div class="flex flex-wrap justify-center gap-3 mb-12 reveal reveal-delay-2">
      <button data-filter="all" class="filter-tab active px-5 py-2 rounded-full text-body-sm font-medium transition-all duration-300 bg-gradient-to-r from-(--color-accent) to-(--color-secondary) text-white">All</button>
      <button data-filter="portrait" class="filter-tab px-5 py-2 rounded-full text-body-sm font-medium transition-all duration-300 bg-surface/50 text-(--color-muted) hover:text-(--color-foreground) border border-transparent hover:border-(--color-muted)/20">Portrait</button>
      <button data-filter="character" class="filter-tab px-5 py-2 rounded-full text-body-sm font-medium transition-all duration-300 bg-surface/50 text-(--color-muted) hover:text-(--color-foreground) border border-transparent hover:border-(--color-muted)/20">Character</button>
      <button data-filter="illustration" class="filter-tab px-5 py-2 rounded-full text-body-sm font-medium transition-all duration-300 bg-surface/50 text-(--color-muted) hover:text-(--color-foreground) border border-transparent hover:border-(--color-muted)/20">Illustration</button>
    </div>

    <!-- Unique Masonry Grid - 10 Items -->
