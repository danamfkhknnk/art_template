          <div class="absolute inset-0 bg-gradient-to-t from-(--color-dark) via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
            <p class="text-caption text-(--color-accent) uppercase tracking-wider mb-1">Portrait</p>
            <h3 class="text-subheading font-display text-(--color-foreground)">Ethereal Portrait</h3>
            <p class="text-body-sm text-(--color-muted) mt-1">Digital painting with custom lighting</p>
          </div>
        </div>
      </div>

