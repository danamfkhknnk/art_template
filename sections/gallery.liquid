        <div class="group relative h-full cursor-pointer rounded-2xl overflow-hidden border border-(--color-muted)/10 hover:border-(--color-accent)/30 transition-all duration-500 hover:shadow-[0_0_30px_rgba(249,115,22,0.15)]">
