<section class="relative bg-black min-h-screen py-24 px-4">
  <div class="absolute inset-0 bg-dark-surface/80 backdrop-blur-sm"></div>
  <div class="relative section-content">
    <div class="text-center mb-16">
      <p class="text-caption tracking-[0.3em] uppercase text-(--color-accent) mb-4 font-medium inline-flex items-center gap-2 reveal">
        <span class="w-8 h-px bg-gradient-to-r from-transparent to-(--color-accent)"></span>
        {{ section.settings.subheading }}
        <span class="w-8 h-px bg-gradient-to-l from-transparent to-(--color-accent)"></span>
      </p>
      <h2 class="text-heading font-display text-(--color-foreground) reveal reveal-delay-1">{{ section.settings.heading }}</h2>
    </div>

    <div class="max-w-3xl mx-auto space-y-4">
      {% for block in section.blocks %}
        <div class="glass-card overflow-hidden reveal" style="transition-delay: {{ forloop.index | times: 0.05 }}s;" {{ block.shopify_attributes }}>
          <button class="faq-toggle w-full flex items-center justify-between p-6 text-left hover:bg-dark/30 transition-colors duration-300">
            <span class="text-body font-medium text-(--color-foreground) pr-4">{{ block.settings.question }}</span>
            <svg class="w-5 h-5 text-(--color-accent) shrink-0 faq-icon transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-500">
            <div class="px-6 pb-6 text-body-sm text-((--color-foreground))/70 leading-relaxed border-t border-(--color-muted)/10 pt-4">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.faq-toggle').forEach(toggle => {
      toggle.addEventListener('click', () => {
        const content = toggle.nextElementSibling;
        const icon = toggle.querySelector('.faq-icon');
        const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';

        document.querySelectorAll('.faq-content').forEach(c => {
          c.style.maxHeight = '0px';
        });
        document.querySelectorAll('.faq-icon').forEach(i => {
          i.style.transform = 'rotate(0deg)';
        });

        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + 'px';
          icon.style.transform = 'rotate(180deg)';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does a commission take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>It depends on the complexity. Simple portraits take 3-5 days, while complex illustrations can take 1-2 weeks. I'll provide an estimated timeline when you commission.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How long does a commission take?",
            "answer": "<p>It depends on the complexity. Simple portraits take 3-5 days, while complex illustrations can take 1-2 weeks. I'll provide an estimated timeline when you commission.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What payment methods do you accept?",
            "answer": "<p>I accept PayPal, Stripe, and bank transfer. Payment is typically split 50% upfront and 50% upon completion.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I use the artwork commercially?",
            "answer": "<p>Commercial use is included in Standard and Premium plans. For Basic plans, you can add commercial use as an add-on for $50.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you offer revisions?",
            "answer": "<p>Yes! Basic includes 2 revisions, Standard includes 4, and Premium includes unlimited revisions.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What if I'm not satisfied with the result?",
            "answer": "<p>I offer unlimited revisions for Premium plans and up to 4 for Standard. Your satisfaction is my priority.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
