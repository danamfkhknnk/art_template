<section class="relative py-24 px-4">
  <div class="absolute inset-0 bg-dark-surface/80 backdrop-blur-sm"></div>
  <div class="relative section-content">
    <div class="flex flex-col items-center mb-16">
      <p class="text-caption tracking-[0.3em] uppercase text-(--color-accent) mb-4 font-medium inline-flex items-center gap-2 reveal">
        <span class="w-8 h-px bg-gradient-to-r from-transparent to-(--color-accent)"></span>
        {{ section.settings.subheading }}
        <span class="w-8 h-px bg-gradient-to-l from-transparent to-(--color-accent)"></span>
      </p>
      <h2 class="text-heading font-display text-(--color-foreground) reveal reveal-delay-1">{{ section.settings.heading }}</h2>
      {% if section.settings.description != blank %}
        <p class="text-body-lg text-((--color-foreground))/60 mt-4 max-w-2xl text-center w-full leading-relaxed reveal reveal-delay-2">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    {% if section.settings.collection != blank %}
      <!-- Gallery-like Masonry Grid from Collection -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 auto-rows-[200px] md:auto-rows-[280px]">
        {% assign products_limit = 50 %}
        {% unless section.settings.show_all %}
          {% assign products_limit = section.settings.products_to_show %}
        {% endunless %}
        {% for product in collections[section.settings.collection].products limit: products_limit %}
          <a href="{{ product.url }}" class="group relative rounded-2xl overflow-hidden border border-(--color-muted)/10 hover:border-(--color-accent)/30 transition-all duration-500 hover:shadow-[0_0_40px_rgba(249,115,22,0.2)] reveal {% if forloop.index == 1 or forloop.index == 4 %}md:row-span-2{% endif %}" style="transition-delay: {{ forloop.index | times: 0.05 }}s;">
            <!-- Product Image -->
            <div class="absolute inset-0">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.title }}"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                <div class="w-full h-full bg-(--color-dark-surface) flex items-center justify-center">
                  <svg class="w-16 h-16 text-(--color-muted)/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              {% endif %}
              <!-- Gradient overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-(--color-dark) via-(--color-dark)/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </div>

            <!-- Product Info Overlay -->
            <div class="absolute bottom-0 left-0 right-0 p-5 md:p-6 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500 z-10">
              {% if product.type != blank %}
                <p class="text-caption text-(--color-accent) uppercase tracking-wider mb-1">{{ product.type }}</p>
              {% endif %}
              <h3 class="text-subheading font-display text-(--color-foreground) mb-1">{{ product.title }}</h3>
              <div class="flex items-center justify-between">
                <p class="text-body-lg font-semibold gradient-text">
                  {% if product.price_min != product.price_max %}
                    {{ product.price_min | money }} - {{ product.price_max | money }}
                  {% else %}
                    {{ product.price | money }}
                  {% endif %}
                </p>
                <span class="text-caption text-(--color-muted) group-hover:text-(--color-accent) transition-colors flex items-center gap-1">
                  View
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                  </svg>
                </span>
              </div>
            </div>

            <!-- Hover glow -->
            <div class="absolute inset-0 bg-(--color-accent)/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <!-- Fallback: Default service cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-{{ section.settings.columns }} gap-6">
        {% for block in section.blocks %}
          <div class="group gradient-border-card p-8 text-center relative overflow-hidden reveal" style="transition-delay: {{ forloop.index | times: 0.1 }}s;" {{ block.shopify_attributes }}>
            <div class="absolute inset-0 bg-gradient-to-b from-(--color-accent)/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative z-10">
              <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-(--color-accent)/10 flex items-center justify-center border border-(--color-accent)/20 group-hover:scale-110 group-hover:shadow-[0_0_30px_rgba(249,115,22,0.3)] group-hover:border-(--color-accent)/40 transition-all duration-500">
                <svg class="w-8 h-8 text-(--color-accent)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="{{ block.icon }}"></path>
                </svg>
              </div>
              <h3 class="text-subheading font-display text-(--color-foreground) mb-3">{{ block.title }}</h3>
              <p class="text-body-sm text-((--color-foreground))/60 leading-relaxed mb-4">{{ block.description }}</p>
              <div class="flex items-center justify-center gap-1 text-caption text-(--color-accent)">
                <span>Starting from</span>
                <span class="font-semibold text-body-sm">{{ block.price }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <div class="text-center mt-12 reveal">
        <a href="{{ section.settings.button_link | default: routes.collections_url }}" class="btn-secondary inline-flex items-center gap-2">
          <span>{{ section.settings.button_label }}</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Services",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collection"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Explore our curated collection of digital art products and templates"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_all",
      "label": "Show all products in collection",
      "default": false
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (fallback)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "View All Products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Portrait"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Detailed character portraits with custom backgrounds"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$50"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "SVG Icon Path",
          "default": "M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "title": "Portrait",
            "description": "Detailed character portraits with custom backgrounds",
            "price": "$50"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Character Design",
            "description": "Full character sheets with multiple poses",
            "price": "$120"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Illustration",
            "description": "Full scene illustrations with complex compositions",
            "price": "$200"
          }
        }
      ]
    }
  ]
}
{% endschema %}
