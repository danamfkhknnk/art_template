<section class="relative py-20 px-4">
  <div class="absolute inset-0 bg-dark/80 backdrop-blur-sm"></div>
  <div class="relative section-content max-w-3xl">
    {% if section.settings.heading != blank %}
      <div class="text-center mb-12">
        <p class="text-caption tracking-[0.3em] uppercase text-(--color-accent) mb-4 font-medium inline-flex items-center gap-2 reveal">
          <span class="w-8 h-px bg-gradient-to-r from-transparent to-(--color-accent)"></span>
          Legal
          <span class="w-8 h-px bg-gradient-to-l from-transparent to-(--color-accent)"></span>
        </p>
        <h2 class="text-heading font-display text-(--color-foreground) reveal reveal-delay-1">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="prose prose-invert max-w-none reveal reveal-delay-2">
      {% if section.settings.content != blank %}
        <div class="text-body text-((--color-foreground))/80 leading-relaxed space-y-4">
          {{ section.settings.content }}
        </div>
      {% endif %}
    </div>

    {% if section.settings.last_updated != blank %}
      <p class="text-caption text-(--color-muted) mt-8 text-center reveal">Last updated: {{ section.settings.last_updated }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Terms of Service",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Terms of Service"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>These terms of service govern your use of our art commission services. By commissioning us, you agree to these terms.</p><h3>Payment Terms</h3><p>Full payment is required before work begins. We accept major credit cards and PayPal.</p><h3>Revision Policy</h3><p>Each commission includes up to 3 revisions. Additional revisions may incur extra charges.</p><h3>Usage Rights</h3><p>Upon full payment, you receive a license to use the artwork for personal or commercial purposes.</p>"
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last Updated",
      "default": "January 2025"
    }
  ],
  "presets": [
    {
      "name": "Terms of Service"
    }
  ]
}
{% endschema %}
