<section id="contact" class="relative py-24 px-4">
  <div class="absolute inset-0 bg-dark/80 backdrop-blur-sm"></div>
  <div class="relative section-content">
    <div class="text-center mb-16">
      <p class="text-caption tracking-[0.3em] uppercase text-(--color-accent) mb-4 font-medium inline-flex items-center gap-2 reveal">
        <span class="w-8 h-px bg-gradient-to-r from-transparent to-(--color-accent)"></span>
        {{ section.settings.subheading }}
        <span class="w-8 h-px bg-gradient-to-l from-transparent to-(--color-accent)"></span>
      </p>
      <h2 class="text-heading font-display text-(--color-foreground) reveal reveal-delay-1">{{ section.settings.heading }}</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Contact Form -->
      <div class="gradient-border-card p-8 reveal">
        <h3 class="text-subheading font-display text-(--color-foreground) mb-6">Send a Message</h3>
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div class="p-4 rounded-lg bg-(--color-success)/10 border border-(--color-success)/20 text-body-sm text-(--color-success) mb-6">
              Thank you for your message! I'll get back to you soon.
            </div>
          {% endif %}
          {% if form.errors %}
            <div class="p-4 rounded-lg bg-red-500/10 border border-red-500/20 text-body-sm text-red-400 mb-6">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
          <div class="space-y-4">
            <input type="text" name="contact[name]" placeholder="Your Name" class="w-full px-4 py-3 rounded-lg bg-dark/50 border border-(--color-muted)/20 text-(--color-foreground) placeholder:text-(--color-muted) focus:border-(--color-accent) focus:ring-1 focus:ring-(--color-accent)/20 focus:outline-none transition-all duration-300" required>
            <input type="email" name="contact[email]" placeholder="Your Email" class="w-full px-4 py-3 rounded-lg bg-dark/50 border border-(--color-muted)/20 text-(--color-foreground) placeholder:text-(--color-muted) focus:border-(--color-accent) focus:ring-1 focus:ring-(--color-accent)/20 focus:outline-none transition-all duration-300" required>
            <select name="contact[service]" class="w-full px-4 py-3 rounded-lg bg-dark/50 border border-(--color-muted)/20 text-(--color-foreground) focus:border-(--color-accent) focus:ring-1 focus:ring-(--color-accent)/20 focus:outline-none transition-all duration-300">
              <option value="">Select Service</option>
              <option value="portrait">Portrait</option>
              <option value="character">Character Design</option>
              <option value="illustration">Illustration</option>
              <option value="template">Shopify Template</option>
            </select>
            <textarea name="contact[body]" placeholder="Tell me about your project..." rows="5" class="w-full px-4 py-3 rounded-lg bg-dark/50 border border-(--color-muted)/20 text-(--color-foreground) placeholder:text-(--color-muted) focus:border-(--color-accent) focus:ring-1 focus:ring-(--color-accent)/20 focus:outline-none transition-all duration-300 resize-none" required></textarea>
            <button type="submit" class="btn-primary w-full">
              <span>Send Message</span>
            </button>
          </div>
        {% endform %}
      </div>

      <!-- Contact Info -->
      <div class="space-y-6 reveal reveal-delay-2">
        <div class="glass-card p-6">
          <h4 class="text-body font-semibold text-(--color-foreground) mb-4">Contact Info</h4>
          <div class="space-y-4">
            <a href="mailto:{{ section.settings.email }}" class="flex items-center gap-3 text-body-sm text-((--color-foreground))/70 hover:text-(--color-accent) transition-colors group">
              <div class="w-10 h-10 rounded-full bg-(--color-accent)/10 flex items-center justify-center border border-(--color-accent)/20 group-hover:shadow-[0_0_15px_rgba(249,115,22,0.2)] transition-all duration-300">
                <svg class="w-5 h-5 text-(--color-accent)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"></path>
                </svg>
              </div>
              {{ section.settings.email }}
            </a>
            <a href="{{ section.settings.discord }}" target="_blank" class="flex items-center gap-3 text-body-sm text-((--color-foreground))/70 hover:text-(--color-accent) transition-colors group">
              <div class="w-10 h-10 rounded-full bg-(--color-accent)/10 flex items-center justify-center border border-(--color-accent)/20 group-hover:shadow-[0_0_15px_rgba(249,115,22,0.2)] transition-all duration-300">
                <svg class="w-5 h-5 text-(--color-accent)" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286z"></path>
                </svg>
              </div>
              Discord: {{ section.settings.discord_name }}
            </a>
          </div>
        </div>

        <div class="glass-card p-6">
          <h4 class="text-body font-semibold text-(--color-foreground) mb-4">Social Media</h4>
          <div class="flex gap-3">
            {% if section.settings.twitter != blank %}
              <a href="{{ section.settings.twitter }}" target="_blank" class="w-10 h-10 rounded-full bg-surface/50 border border-(--color-muted)/10 flex items-center justify-center hover:border-(--color-accent)/30 hover:bg-(--color-accent)/10 transition-all duration-300 hover:shadow-[0_0_15px_rgba(249,115,22,0.2)]">
                <svg class="w-5 h-5 text-(--color-muted)" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.instagram != blank %}
              <a href="{{ section.settings.instagram }}" target="_blank" class="w-10 h-10 rounded-full bg-surface/50 border border-(--color-muted)/10 flex items-center justify-center hover:border-(--color-accent)/30 hover:bg-(--color-accent)/10 transition-all duration-300 hover:shadow-[0_0_15px_rgba(249,115,22,0.2)]">
                <svg class="w-5 h-5 text-(--color-muted)" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.pixiv != blank %}
              <a href="{{ section.settings.pixiv }}" target="_blank" class="w-10 h-10 rounded-full bg-surface/50 border border-(--color-muted)/10 flex items-center justify-center hover:border-(--color-accent)/30 hover:bg-(--color-accent)/10 transition-all duration-300 hover:shadow-[0_0_15px_rgba(249,115,22,0.2)]">
                <svg class="w-5 h-5 text-(--color-muted)" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M4.935 0A4.924 4.924 0 000 4.935v14.13A4.924 4.924 0 004.935 24h14.13A4.924 4.924 0 0024 19.065V4.935A4.924 4.924 0 0019.065 0zm7.826 3.19c2.853 0 5.165 2.312 5.165 5.165v1.594c0 2.853-2.312 5.165-5.165 5.165-2.853 0-5.165-2.312-5.165-5.165V8.355c0-2.853 2.312-5.165 5.165-5.165zm0 2.366c-1.552 0-2.799 1.247-2.799 2.799v1.594c0 1.552 1.247 2.799 2.799 2.799 1.552 0 2.799-1.247 2.799-2.799V8.355c0-1.552-1.247-2.799-2.799-2.799zm5.067 2.013c.55 0 .996.446.996.996s-.446.996-.996.996-.996-.446-.996-.996.446-.996.996-.996zm-5.067 1.498c.87 0 1.575.705 1.575 1.575v1.594c0 .87-.705 1.575-1.575 1.575-.87 0-1.575-.705-1.575-1.575V9.637c0-.87.705-1.575 1.575-1.575z"></path>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>

        <div class="glass-card p-6">
          <h4 class="text-body font-semibold text-(--color-foreground) mb-4">Availability</h4>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-(--color-success) animate-pulse"></span>
            <span class="text-body-sm text-((--color-foreground))/70">{{ section.settings.availability }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get In Touch"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@example.com"
    },
    {
      "type": "text",
      "id": "discord",
      "label": "Discord Invite Link",
      "default": "#"
    },
    {
      "type": "text",
      "id": "discord_name",
      "label": "Discord Name",
      "default": "username"
    },
    {
      "type": "text",
      "id": "twitter",
      "label": "Twitter URL"
    },
    {
      "type": "text",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "pixiv",
      "label": "Pixiv URL"
    },
    {
      "type": "text",
      "id": "availability",
      "label": "Availability Status",
      "default": "Currently Open for Commissions"
    }
  ],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
